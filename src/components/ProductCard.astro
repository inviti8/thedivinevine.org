---
import { formatUsd } from '~/lib/site-config';

interface Props {
  slug: string;
  name: string;
  size: string;
  priceUsd: number;
  primaryImage: string;
}

const { slug, name, size, priceUsd, primaryImage } = Astro.props;
---

<a href={`/shop/${slug}`} class="group block no-underline">
  <div class="aspect-[3/4] overflow-hidden border border-gilt/30 bg-plum-deep">
    <img
      src={primaryImage}
      alt={name}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  </div>
  <div class="mt-3 text-center">
    <p class="eyebrow">{size}</p>
    <h3 class="mt-1 font-display text-xl text-parchment transition-colors group-hover:text-gilt">{name}</h3>
    <p class="price mt-1">{formatUsd(priceUsd)}</p>
  </div>
</a>
