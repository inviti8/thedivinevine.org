---
import Base from '~/layouts/Base.astro';
---

<Base title="Page Not Found">
  <section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="eyebrow">404</p>
    <h1 class="mt-2">This path has grown over</h1>
    <p class="mt-6 text-parchment-dim italic">The page you were looking for couldn't be found.</p>
    <a href="/" class="btn mt-8">Return home</a>
  </section>
</Base>
