# Copy to .env for `astro dev` (and .dev.vars for `wrangler pages dev`).
PUBLIC_SITE_URL=http://localhost:4321

# Stripe (phase 3) — dev refuses anything but sk_test_ keys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Mailtrap transactional email (phase 3+)
MAILTRAP_API_TOKEN=replace_me
EMAIL_FROM=hello@thedivinevine.org
OWNER_EMAIL=owner@example.com

# Booking (phase 4) — iCloud published calendar URL(s), comma-separated
OWNER_ICS_URL=
# HMAC secret for booking + newsletter links
SIGNING_SECRET=replace_me_with_a_long_random_string

# true = log emails instead of sending
DEBUG=true
