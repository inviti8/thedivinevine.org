# Local secrets for `npm run dev` / `npm run preview`.
# Copy this file to .dev.vars (never committed). Everything is optional:
# unset features answer "unavailable" instead of breaking the site.
# In production these are set as Cloudflare Pages secrets instead.

PUBLIC_SITE_URL=http://localhost:4321

# Stripe (milestone B) — dev refuses anything but sk_test_ keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailtrap transactional email
MAILTRAP_API_TOKEN=
EMAIL_FROM=hello@thedivinevine.org
OWNER_EMAIL=

# Booking — iCloud published calendar URL(s), comma-separated (webcal:// is fine)
OWNER_ICS_URL=

# HMAC secret for booking + newsletter links, at least 32 characters.
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# true = log emails instead of sending (the default under `npm run dev`)
DEBUG=true
